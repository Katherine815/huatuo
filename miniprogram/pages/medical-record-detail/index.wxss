page {
  background: #f4f1ea;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  width: 100%;
}

.record-header {
  align-items: center;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.record-title {
  flex: 1;
  min-width: 0;
}

.record-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
}

.eyebrow {
  color: #7b6f5e;
  font-size: 22rpx;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.title {
  color: #1f2933;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  color: #65737e;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.outline-button,
.primary-button {
  background: #2f6f5e;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 60rpx;
  min-height: 60rpx;
  padding: 0 24rpx;
}

.outline-button {
  background: #ffffff;
  border: 1rpx solid #c9d7d0;
  color: #2f6f5e;
}

.compact-button {
  align-items: center;
  box-sizing: border-box;
  display: inline-flex;
  font-size: 24rpx;
  justify-content: center;
  line-height: 56rpx;
  margin: 0;
  min-width: 0;
  min-height: 56rpx;
  padding: 0 18rpx;
  width: auto;
}

.trash-banner {
  background: #fffaf0;
  border: 1rpx solid #ead9b8;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #6c5f4b;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
}

.meta-grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 20rpx;
}

.meta-item,
.content-block {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.meta-item {
  min-height: 118rpx;
  padding: 20rpx;
}

.field-label {
  color: #1f2933;
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.label {
  color: #7b6f5e;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.value {
  color: #1f2933;
  font-size: 27rpx;
  line-height: 1.35;
  word-break: break-all;
}

.content-block {
  margin-top: 18rpx;
  padding: 24rpx;
}

.block-title {
  color: #1f2933;
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.block-subtitle {
  color: #8a8172;
  font-size: 22rpx;
  line-height: 1.35;
  margin-bottom: 18rpx;
}

.paragraph {
  color: #1f2933;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.field-row {
  border-top: 1rpx solid #eee7da;
  padding: 18rpx 0;
}

.field-row:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.field-row:last-child {
  padding-bottom: 0;
}

.field-value {
  color: #1f2933;
  font-size: 27rpx;
  line-height: 1.55;
}

.danger-button {
  background: #fff7f5;
  border: 1rpx solid #f2b8ad;
  border-radius: 8rpx;
  color: #b42318;
  font-size: 28rpx;
  line-height: 72rpx;
  margin-top: 30rpx;
  min-height: 72rpx;
  width: 100%;
}

.trash-actions {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr;
  margin-top: 30rpx;
}

.restore-button {
  background: #e8f3ee;
  border-radius: 8rpx;
  color: #1f4f43;
  font-size: 28rpx;
  line-height: 72rpx;
  min-height: 72rpx;
  width: 100%;
}

.trash-actions .danger-button {
  margin-top: 0;
}

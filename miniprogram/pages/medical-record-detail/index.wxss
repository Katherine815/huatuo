page {
  background: #f4f1ea;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  width: 100%;
}

.record-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #7b6f5e;
  font-size: 22rpx;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.title {
  color: #1f2933;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  color: #65737e;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.primary-button {
  background: #2f6f5e;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 60rpx;
  min-height: 60rpx;
  padding: 0 24rpx;
}

.meta-grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 20rpx;
}

.meta-item,
.content-block {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.meta-item {
  min-height: 118rpx;
  padding: 20rpx;
}

.field-label {
  color: #1f2933;
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.label {
  color: #7b6f5e;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.value {
  color: #1f2933;
  font-size: 27rpx;
  line-height: 1.35;
  word-break: break-all;
}

.content-block {
  margin-top: 18rpx;
  padding: 24rpx;
}

.block-title {
  color: #1f2933;
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.block-subtitle {
  color: #8a8172;
  font-size: 22rpx;
  line-height: 1.35;
  margin-bottom: 18rpx;
}

.paragraph {
  color: #1f2933;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.field-row {
  border-top: 1rpx solid #eee7da;
  padding: 18rpx 0;
}

.field-row:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.field-row:last-child {
  padding-bottom: 0;
}

.field-value {
  color: #1f2933;
  font-size: 27rpx;
  line-height: 1.55;
}

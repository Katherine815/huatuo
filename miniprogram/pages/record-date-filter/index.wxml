<view class="page" wx:if="{{patient}}">
  <view class="header">
    <view class="eyebrow">Date Filter</view>
    <view class="title">{{patient.name}}</view>
    <view class="subtitle">选择某一天，只查看当天医疗记录</view>
  </view>

  <view class="calendar-card">
    <view class="month-row">
      <button class="month-button" bindtap="onPreviousMonth">‹</button>
      <view class="month-title">{{monthTitle}}</view>
      <button class="month-button" bindtap="onNextMonth">›</button>
    </view>

    <view class="weekday-grid">
      <view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view>
    </view>

    <view class="day-grid">
      <view
        wx:for="{{days}}"
        wx:key="key"
        class="{{item.className}}"
        data-date="{{item.date}}"
        bindtap="onSelectDate"
      >
        <view wx:if="{{!item.isEmpty}}" class="day-number">{{item.day}}</view>
        <view wx:if="{{item.hasRecord}}" class="record-dot"></view>
        <view wx:if="{{item.hasRecord}}" class="record-count">{{item.recordCount}}</view>
      </view>
    </view>
  </view>

  <view class="hint">直接返回会退出筛选，并显示全部医疗记录。</view>
</view>

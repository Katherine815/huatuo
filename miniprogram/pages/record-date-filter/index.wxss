page {
  background: #f4f1ea;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  width: 100%;
}

.header {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #7b6f5e;
  font-size: 22rpx;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.title {
  color: #1f2933;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  color: #65737e;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.calendar-card {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
  padding: 24rpx;
}

.month-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.month-button {
  align-items: center;
  background: #edf2ef;
  border-radius: 8rpx;
  color: #2f6f5e;
  display: flex;
  font-size: 42rpx;
  height: 64rpx;
  justify-content: center;
  line-height: 64rpx;
  padding: 0;
  width: 64rpx;
}

.month-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
}

.weekday-grid,
.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.weekday {
  color: #8a8172;
  font-size: 22rpx;
  line-height: 52rpx;
  text-align: center;
}

.day-grid {
  gap: 8rpx;
}

.day-cell {
  align-items: center;
  background: #fbfaf6;
  border: 1rpx solid #ebe2d5;
  border-radius: 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 82rpx;
  justify-content: center;
  position: relative;
}

.day-cell.empty {
  background: transparent;
  border-color: transparent;
}

.day-cell.has-record {
  background: #eef7f2;
  border-color: #8bb9a7;
}

.day-number {
  color: #1f2933;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
}

.record-dot {
  background: #2f6f5e;
  border-radius: 50%;
  height: 8rpx;
  margin-top: 8rpx;
  width: 8rpx;
}

.record-count {
  color: #2f6f5e;
  font-size: 18rpx;
  font-weight: 700;
  position: absolute;
  right: 8rpx;
  top: 6rpx;
}

.hint {
  color: #7b6f5e;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 22rpx;
  text-align: center;
}

page {
  background: #f4f1ea;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  width: 100%;
}

.header {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #7b6f5e;
  font-size: 22rpx;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.title {
  color: #1f2933;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  color: #65737e;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.form-card {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
}

.field {
  border-bottom: 1rpx solid #eee7da;
  padding: 24rpx 0;
}

.field.last {
  border-bottom: 0;
}

.label {
  color: #1f2933;
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.input {
  background: #fbfaf6;
  border: 1rpx solid #ded5c4;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #1f2933;
  font-size: 28rpx;
  height: 78rpx;
  padding: 0 18rpx;
  width: 100%;
}

.picker-row {
  align-items: center;
  background: #fbfaf6;
  border: 1rpx solid #ded5c4;
  border-radius: 8rpx;
  box-sizing: border-box;
  display: flex;
  height: 78rpx;
  justify-content: space-between;
  padding: 0 18rpx;
}

.picker-value {
  color: #1f2933;
  font-size: 28rpx;
}

.picker-action {
  color: #2f6f5e;
  font-size: 24rpx;
  font-weight: 700;
}

.save-button {
  background: #2f6f5e;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
  margin-top: 28rpx;
  min-height: 76rpx;
  width: 100%;
}

page {
  background: #f4f1ea;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  width: 100%;
}

.summary {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.summary-title {
  flex: 1;
  min-width: 0;
}

.header-actions {
  align-items: center;
  display: flex;
  flex: 0 0 auto;
  gap: 10rpx;
}

.eyebrow {
  color: #7b6f5e;
  font-size: 22rpx;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.title {
  color: #1f2933;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.icon-button {
  align-items: center;
  background: #2f6f5e;
  border-radius: 8rpx;
  color: #ffffff;
  display: flex;
  font-size: 44rpx;
  height: 76rpx;
  justify-content: center;
  line-height: 76rpx;
  padding: 0;
  width: 76rpx;
}

.tool-button {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #d7ccbb;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #4f5d67;
  display: flex;
  font-size: 26rpx;
  height: 48rpx;
  justify-content: center;
  opacity: 0.72;
  width: 48rpx;
}

.auth-banner {
  background: #fffaf0;
  border: 1rpx solid #ead9b8;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
}

.auth-title {
  color: #5d4d2f;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.auth-copy {
  color: #6c5f4b;
  font-size: 24rpx;
  line-height: 1.5;
}

.auth-openid {
  color: #8a8172;
  font-size: 21rpx;
  line-height: 1.45;
  margin-top: 10rpx;
  word-break: break-all;
}

.search-box {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e1d8c8;
  border-radius: 8rpx;
  box-sizing: border-box;
  display: flex;
  gap: 14rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
}

.search-icon {
  color: #65737e;
  font-size: 34rpx;
  width: 36rpx;
}

.search-input {
  color: #1f2933;
  flex: 1;
  font-size: 30rpx;
  height: 86rpx;
}

.clear-button {
  background: #edf2ef;
  border-radius: 8rpx;
  color: #2f6f5e;
  font-size: 24rpx;
  line-height: 52rpx;
  min-height: 52rpx;
  padding: 0 18rpx;
}

.stats-row {
  display: grid;
  gap: 18rpx;
  grid-template-columns: 1fr 1fr;
  margin: 24rpx 0 28rpx;
}

.stat {
  background: #ffffff;
  border: 1rpx solid #e5ded0;
  border-radius: 8rpx;
  box-sizing: border-box;
  min-width: 0;
  padding: 22rpx;
}

.stat-value {
  color: #2f6f5e;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.stat-label {
  color: #65737e;
  font-size: 24rpx;
  margin-top: 10rpx;
  white-space: normal;
}

.section-heading {
  color: #1f2933;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.patient-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.patient-card {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
  padding: 24rpx;
}

.patient-main {
  align-items: baseline;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.patient-name {
  color: #1f2933;
  font-size: 34rpx;
  font-weight: 700;
}

.patient-no {
  color: #7b6f5e;
  font-size: 22rpx;
}

.patient-meta {
  color: #4f5d67;
  display: flex;
  font-size: 26rpx;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.contact {
  color: #65737e;
  font-size: 26rpx;
  line-height: 1.45;
}

.empty-state {
  background: #ffffff;
  border: 1rpx dashed #cfc3af;
  border-radius: 8rpx;
  box-sizing: border-box;
  padding: 40rpx 24rpx;
  text-align: center;
}

.empty-title {
  color: #1f2933;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.empty-copy {
  color: #65737e;
  font-size: 24rpx;
}

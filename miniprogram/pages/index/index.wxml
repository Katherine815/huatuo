<view class="page">
  <view class="summary">
    <view class="summary-title">
      <view class="eyebrow">TCM Medical Records</view>
      <view class="title">病人档案</view>
    </view>
    <view class="header-actions">
      <button class="add-patient-button" bindtap="onCreatePatient">新增病人</button>
    </view>
  </view>

  <view class="auth-banner">
    <view class="auth-title">访问控制</view>
    <view class="auth-copy">
      <text>{{authStatus}}</text>
      <text wx:if="{{authName}}">：{{authName}}</text>
      <text
        wx:if="{{authName}}"
        class="copy-auth-link"
        data-label="姓名"
        data-value="{{authName}}"
        bindtap="onCopyAuthValue"
      >复制</text>
    </view>
    <view wx:if="{{authOpenid}}" class="auth-openid">
      <text>OpenID：{{authOpenid}}</text>
      <text
        class="copy-auth-link"
        data-label="OpenID"
        data-value="{{authOpenid}}"
        bindtap="onCopyAuthValue"
      >复制</text>
    </view>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      placeholder="搜索姓名、联系或病人编号"
      value="{{keyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
    />
    <button wx:if="{{keyword}}" class="clear-button" bindtap="onClearSearch">清除</button>
  </view>

  <view class="stats-row">
    <view class="stat">
      <view class="stat-value">{{totalPatientCount}}</view>
      <view class="stat-label">病人总数</view>
    </view>
    <view class="stat">
      <view class="stat-value">{{totalMedicalRecordCount}}</view>
      <view class="stat-label">就诊记录总数</view>
    </view>
  </view>

  <view class="section-bar">
    <view class="section-heading">病人列表</view>
    <view class="section-actions">
      <view class="{{dateFilterButtonClass}}" bindtap="onOpenDateFilter">
        <text wx:if="{{hasDateFilter}}" class="filter-x">×</text>
        <text>{{dateFilterLabel}}</text>
      </view>
      <view class="section-action-button" bindtap="onImportJson">导入</view>
      <view class="section-action-button" bindtap="onOpenTrash">回收站</view>
    </view>
  </view>

  <view wx:if="{{hasDateFilter}}" class="filtered-record-panel">
    <view class="filtered-title">{{selectedVisitDate}} 就诊记录</view>
    <view wx:if="{{!hasFilteredRecords}}" class="empty-state">
      <view class="empty-title">这一天没有就诊记录</view>
      <view class="empty-copy">再次点击筛选按钮，即可显示全部病人。</view>
    </view>
    <view wx:for="{{filteredRecords}}" wx:key="id" class="filtered-record-card" data-id="{{item.id}}" bindtap="onOpenFilteredRecord">
      <view class="filtered-record-top">
        <view>
          <view class="filtered-patient-name">{{item.patientName}}</view>
          <view class="filtered-patient-no">{{item.patientNo}}</view>
        </view>
        <view class="filtered-record-no">{{item.recordNo}}</view>
      </view>
      <view class="chief-title">主诉</view>
      <view class="chief-copy">{{item.chiefComplaint}}</view>
      <view class="filtered-footer">查看完整记录</view>
    </view>
  </view>

  <view wx:if="{{!hasDateFilter && !hasPatients}}" class="empty-state">
    <view class="empty-title">没有匹配的病人</view>
    <view class="empty-copy">请尝试姓名、联系方式或病人编号。</view>
  </view>

  <view wx:if="{{!hasDateFilter}}" class="patient-list">
    <view
      wx:for="{{patients}}"
      wx:key="id"
      class="patient-card"
      data-id="{{item.id}}"
      bindtap="onOpenPatient"
    >
      <view class="patient-main">
        <view class="patient-name">{{item.name}}</view>
        <view class="patient-no">{{item.patientNo}}</view>
      </view>
      <view class="patient-meta">
        <text>{{item.gender}}</text>
        <text>{{item.birthDate}}</text>
      </view>
      <view class="contact">{{item.contact}}</view>
    </view>
  </view>
</view>

<view class="page">
  <view class="summary">
    <view>
      <view class="eyebrow">TCM Medical Records</view>
      <view class="title">病人档案</view>
    </view>
    <button class="icon-button" bindtap="onCreatePatient" aria-label="新增病人">＋</button>
  </view>

  <view class="auth-banner">
    <view class="auth-title">访问控制</view>
    <view class="auth-copy">{{authStatus}}</view>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      placeholder="搜索姓名、联系或病人编号"
      value="{{keyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
    />
    <button wx:if="{{keyword}}" class="clear-button" bindtap="onClearSearch">清除</button>
  </view>

  <view class="stats-row">
    <view class="stat">
      <view class="stat-value">{{totalPatientCount}}</view>
      <view class="stat-label">病人总数</view>
    </view>
    <view class="stat">
      <view class="stat-value">{{totalMedicalRecordCount}}</view>
      <view class="stat-label">医疗记录总数</view>
    </view>
  </view>

  <view class="section-heading">病人列表</view>

  <view wx:if="{{!hasPatients}}" class="empty-state">
    <view class="empty-title">没有匹配的病人</view>
    <view class="empty-copy">请尝试姓名、联系方式或病人编号。</view>
  </view>

  <view class="patient-list">
    <view
      wx:for="{{patients}}"
      wx:key="id"
      class="patient-card"
      data-id="{{item.id}}"
      bindtap="onOpenPatient"
    >
      <view class="patient-main">
        <view class="patient-name">{{item.name}}</view>
        <view class="patient-no">{{item.patientNo}}</view>
      </view>
      <view class="patient-meta">
        <text>{{item.gender}}</text>
        <text>{{item.birthDate}}</text>
      </view>
      <view class="contact">{{item.contact}}</view>
    </view>
  </view>
</view>

page {
  background: #f4f1ea;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  width: 100%;
}

.profile-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.eyebrow {
  color: #7b6f5e;
  font-size: 22rpx;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.name {
  color: #1f2933;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.outline-button,
.primary-button {
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 60rpx;
  min-height: 60rpx;
  padding: 0 24rpx;
}

.outline-button {
  background: #ffffff;
  border: 1rpx solid #c9d7d0;
  color: #2f6f5e;
}

.primary-button {
  background: #2f6f5e;
  color: #ffffff;
}

.profile-grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 34rpx;
}

.profile-item {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
  min-height: 126rpx;
  padding: 20rpx;
}

.label {
  color: #7b6f5e;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.value {
  color: #1f2933;
  font-size: 28rpx;
  line-height: 1.35;
  word-break: break-all;
}

.records-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
}

.section-copy {
  color: #65737e;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
  padding: 24rpx;
}

.record-top {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.visit-date {
  color: #2f6f5e;
  font-size: 32rpx;
  font-weight: 700;
}

.record-no {
  color: #7b6f5e;
  font-size: 22rpx;
}

.chief-title {
  color: #7b6f5e;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.chief-copy {
  color: #1f2933;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 18rpx;
}

.record-footer {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.updated,
.open-link {
  color: #8a8172;
  font-size: 22rpx;
}

.open-link {
  color: #2f6f5e;
  font-weight: 700;
}

.empty-state {
  background: #ffffff;
  border: 1rpx dashed #cfc3af;
  border-radius: 8rpx;
  box-sizing: border-box;
  padding: 40rpx 24rpx;
  text-align: center;
}

.empty-title {
  color: #1f2933;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.empty-copy {
  color: #65737e;
  font-size: 24rpx;
}

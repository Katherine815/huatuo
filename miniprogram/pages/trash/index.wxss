page {
  background: #f4f1ea;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  width: 100%;
}

.header {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #7b6f5e;
  font-size: 22rpx;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.title {
  color: #1f2933;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  color: #65737e;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.trash-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.trash-card,
.empty-state {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
  padding: 24rpx;
}

.trash-top {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.trash-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.trash-detail,
.trash-time {
  color: #65737e;
  font-size: 24rpx;
  line-height: 1.5;
}

.trash-count {
  align-items: center;
  background: #e8f3ee;
  border-radius: 50%;
  color: #1f4f43;
  display: flex;
  font-size: 26rpx;
  font-weight: 700;
  height: 54rpx;
  justify-content: center;
  width: 54rpx;
}

.empty-state {
  border-style: dashed;
  text-align: center;
}

.empty-title {
  color: #1f2933;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.empty-copy {
  color: #65737e;
  font-size: 24rpx;
}

page {
  background: #f4f1ea;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
  width: 100%;
}

.edit-header {
  align-items: center;
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.edit-title-block {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: #7b6f5e;
  font-size: 22rpx;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.title {
  color: #1f2933;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  color: #65737e;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.save-button {
  background: #2f6f5e;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
}

.top-save {
  align-items: center;
  box-sizing: border-box;
  display: inline-flex;
  flex: 0 0 auto;
  justify-content: center;
  margin: 0;
  min-height: 56rpx;
  min-width: 0;
  line-height: 56rpx;
  padding: 0 18rpx;
  width: auto;
}

.date-row {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
  min-height: 86rpx;
  padding: 16rpx 20rpx;
}

.date-label {
  color: #8a8172;
  font-size: 22rpx;
  line-height: 1.3;
  margin-bottom: 4rpx;
}

.date-value {
  color: #4f5d67;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.date-action {
  color: #2f6f5e;
  font-size: 24rpx;
  font-weight: 700;
}

.bottom-save {
  margin-top: 26rpx;
  width: 100%;
}

.form-section {
  background: #ffffff;
  border: 1rpx solid #e3dac8;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.section-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.section-subtitle {
  color: #8a8172;
  font-size: 22rpx;
  line-height: 1.35;
  margin: 6rpx 0 20rpx;
}

.field-group {
  border-top: 1rpx solid #eee7da;
  padding: 22rpx 0;
}

.field-group:first-child {
  border-top: 0;
  padding-top: 0;
}

.field-group:last-child {
  padding-bottom: 0;
}

.group-label {
  color: #1f2933;
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.checkbox-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.checkbox-chip {
  align-items: center;
  background: #f7f5ef;
  border: 1rpx solid #ded5c4;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #1f2933;
  display: flex;
  font-size: 26rpx;
  gap: 8rpx;
  min-height: 62rpx;
  padding: 0 16rpx;
}

.checkbox-chip checkbox {
  transform: scale(1.18);
  transform-origin: left center;
}

.textarea-wrap {
  margin-top: 8rpx;
}

.textarea {
  background: #fbfaf6;
  border: 1rpx solid #ded5c4;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #1f2933;
  font-size: 28rpx;
  line-height: 1.55;
  min-height: 220rpx;
  padding: 18rpx;
  width: 100%;
}

.textarea.small {
  min-height: 160rpx;
}

.counter {
  color: #8a8172;
  font-size: 22rpx;
  margin-top: 8rpx;
  text-align: right;
}
